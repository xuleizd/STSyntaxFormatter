  <Commands package="guidSTFormatterPackage">
    <Groups>
      <Group guid="guidSTFormatterCmdSet" id="MyMenuGroup" priority="0x0100">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_ITEMNODE"/>
