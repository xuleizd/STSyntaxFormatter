    </Groups>

    <Buttons>
      <Button guid="guidSTFormatterCmdSet" id="FormatSTCommandId" priority="0x0100" type="Button">
        <Parent guid="guidSTFormatterCmdSet" id="MyMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Format ST Code</ButtonText>
          <ToolTipText>Format the Structured Text code in the active document</ToolTipText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidSTFormatterPackage" value="{b2e3c4d5-e6f7-8901-abcd-ef2345678901}" />
