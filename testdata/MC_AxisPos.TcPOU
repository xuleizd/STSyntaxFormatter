    <Action Name="Act_DataIn" Id="{3ed9aa3e-ac69-4381-9b1f-27d9305a8624}" FolderPath="Cyclic\">
      <Implementation>
        <ST><![CDATA[END_PROGRAM

{attribute 'hide'}


Ax.ReadStatus ();


fbAxisInfo.Execute := NOT fbAxisInfo.Busy
 AND sAxisName = '';

fbAxisInfo (
Parameter := stAxisParameterSet,
 Axis := Ax);


    // 轴名称


 sAxisName := stAxisParameterSet.sAxisName;

    // 轴状态


 eAxisState := TO_INT (Ax.Status.MotionState);

sAxisStatus := TO_STRING (eAxisState);

    // 轴报警


 bAxisError := Ax.Status.Error;

    // 轴报警代码


 udiAxisErrorID := Ax.Status.ErrorID;

    // 命令扭矩


 lrSetTorque := Ax.NcToPlc.SetTorque;

    // 命令位置


 lrSetPosition := Ax.NcToPlc.SetPos;

    // 命令速度


 lrSetVelocity := Ax.NcToPlc.SetVelo;

    // 实际扭矩


 lrActTorque := Ax.NcToPlc.ActTorque;

    // 实际位置


 lrActPosition := Ax.NcToPlc.ActPos;

    // 实际速度


 lrActVelocity := Ax.NcToPlc.ActVelo;

    // 位置跟随误差


 lrActPosDiff := Ax.NcToPlc.PosDiff;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="Act_Halt" Id="{29917f3c-b264-4ba4-8ec6-de60fae7478b}" FolderPath="Cyclic\">
      <Implementation>
        <ST><![CDATA[END_PROGRAM

{attribute 'hide'}


fbHalt (
Axis := Ax,
 Execute := xHaltExe,
 Deceleration := lrHaltDec,
 Jerk :=,
 BufferMode :=,
 Options :=,
 Done = > bHaltDone,
 Busy = > bHaltBusy,
 Active = >,
 CommandAborted = > bHaltComAbd,
 Error = > bHaltError,
 ErrorID = > udiHaltErrorID);
]]></ST>
      </Implementation>
    </Action>
