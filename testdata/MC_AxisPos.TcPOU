    <Action Name="Act_MovVel" Id="{c0a00eec-a3d5-40f8-b35b-c5ce98f57efe}" FolderPath="Cyclic\">
      <Implementation>
        <ST><![CDATA[END_PROGRAM

{attribute 'hide'}



IF fbMovVel.Velocity >= 0 THEN

fbMovVel.Direction := MC_Direction.MC_Positive_Direction;

ELSE

fbMovVel.Direction := MC_Direction.MC_Negative_Direction;

    END_IF


fbMovVel (
Axis := Ax,
 Execute := xMovVelExe,
 Velocity := lrMovVelVelo,
 Acceleration := lrMovVelAcc,
 Deceleration := lrMovVelDec,
 Jerk :=,
 Direction :=,
 BufferMode :=,
 Options :=,
 InVelocity = > bMovVelInVelocity,
 Busy = > bMovVelBusy,
 Active = > bMovVelActive,
 CommandAborted = > bMovVelCmdAbd,
 Error = > bMovVelError,
 ErrorID = > udiMovVelErrorID);
]]></ST>
      </Implementation>
    </Action>
