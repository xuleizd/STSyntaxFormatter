 Velocity := lrJOGVelo,
 Acceleration := lrJOGACC,
 Deceleration := lrJOGDEC,
 Jerk :=,
 Done = >,
 Busy = > bJOGBusy,
 Active = >,
 CommandAborted = > bJOGComabd,
 Error = > bJOGError,
 ErrorID = > udiJOGErrorID);
]]></ST>
      </Implementation>
