	lrEvenRowInVeloPosition				:LREAL;
	lrEvenRowTakePhotoPosition			:LREAL;
	lrEvenRowStopPhotoPosition			:LREAL;
	lrEvenRowEndConstantSpdPosition		:LREAL;
	lrEvenRowStopMovePosition			:LREAL;
	
	// 行
