    //END_CASE\
 

 IF SafeRun THEN
 Run_Stop := 1;

SafeRun := 0;

END_IF

 CASE iSafeStep OF
 0 : IF bSafeRestart THEN
 restart := 1;

iSafeStep := 1;

END_IF
 1 :
 TON3 (IN := NOT TON3.Q, PT := T#500MS, Q = >, ET = >);

IF Restart = 1 AND TON3.Q THEN

Restart := 0;

bSafeRestart := 0;

iSafeStep := 0;

    END_IF

END_CASE
]]></ST>
