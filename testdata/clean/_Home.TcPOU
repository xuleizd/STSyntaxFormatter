<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="_Home" Id="{afdb9434-577b-41f5-ad59-27efb8bb840b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM _Home


VAR


    END_VAR

END_PROGRAM

]]></Declaration>
    <Implementation>
      <ST><![CDATA[END_PROGRAM

CASE HomeStep OF


0:

bLimitHomeZ := TRUE;

IF mcStepLimitSwitchZ.Done THEN

bLimitHomeZ := FALSE;

HomeStep := HomeStep + 1;

            END_IF


1:

bPulseHomeZ := TRUE;

IF mcStepReferenceZ.done THEN

bPulseHomeZ := FALSE;

HomeStep := HomeStep + 1;

            END_IF


2:
            bFinishHomeZ := TRUE;

IF mcFinishHomingZ.done THEN

bFinishHomeZ := FALSE;

HomeStep := HomeStep + 1;

            END_IF



3:
            bLimitHomeX := TRUE;

bLimitHomeY := TRUE;

IF mcStepLimitSwitchX.done AND mcStepLimitSwitchY.done THEN

bLimitHomeX := FALSE;

bLimitHomeY := FALSE;

HomeStep := HomeStep + 1;

            END_IF


4:
            bPulseHomeX := TRUE;

bPulseHomeY := TRUE;

IF mcStepReferenceX.Done AND mcStepReferenceY.Done THEN

bPulseHomeX := FALSE;

bPulseHomeY := FALSE;

HomeStep := HomeStep + 1;

            END_IF


5:
            bFinishHomeX := TRUE;

bFinishHomeY := TRUE;

IF mcFinishHomingX.Done AND mcFinishHomingY.Done THEN

bFinishHomeX := FALSE;

bFinishHomeY := FALSE;

HomeStep := HomeStep + 1;

            END_IF


6:

bOffsetHomeX := TRUE;

bOffsetHomeY := TRUE;

bOffsetHomeZ := TRUE;

IF mcSetOffsetHomePosX.Done
 AND mcSetOffsetHomePosY.Done
 AND mcSetOffsetHomePosZ.Done THEN

bOffsetHomeX := FALSE;

bOffsetHomeY := FALSE;

bOffsetHomeZ := FALSE;

homedone := TRUE;

            END_IF

    END_CASE
]]></ST>
    </Implementation>
