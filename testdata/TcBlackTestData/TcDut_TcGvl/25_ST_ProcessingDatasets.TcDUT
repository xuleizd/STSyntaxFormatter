    lrRowInVeloPositionDis : LREAL := 30.000; // 行到达匀速点与中心点间距
    lrRowTriggerTakePhotoDis : LREAL := 10.000;
    lrRowTriggerStopPhotoDis : LREAL := 10.000;
    lrRowEndConstantSpdDis : LREAL := 25.000;
    lrRowStopMoveDis : LREAL := 30.000;
END_STRUCT
END_TYPE
]]></Declaration>
