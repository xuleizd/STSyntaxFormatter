    lrTargetAreaHeightInUse : LREAL := 10.000;
    lrTargetAreaCentralPointXInUse : LREAL := 0.0000;
    lrTargetAreaCentralPointYInUse : LREAL := 0.0000;
    bTargetAreaDatasetOKInUse : BOOL;
    bFirstRowArrived : BOOL; // 到首行开始加工位置准备
    // 至准备位
    iStepGoPrepaingPos : INT;
    bTriggerGoPreparingPos : BOOL;
    stTargetRowData : ST_SingleRowData;
    // 单行动作情况
    iStepSingleRowProcess : INT;
    bTriggerStartSingleRow : BOOL;
    bStartPhotoSignal : BOOL;
    bStopPhotoSignal : BOOL;
    // 状态机管理
    bTriggerAbortring : BOOL;
    bTriggerClearError : BOOL;
    iStepClearError : INT;
    bTriggerReseting : BOOL;
    bTriggerStart : BOOL;
    bTriggerPause : BOOL;
    bProcessingState : BOOL;
END_VAR
VAR_GLOBAL PERSISTENT
    AxisZPos0 : LREAL; //Z轴待机位
    AxisZPos1 : LREAL; //Z轴工作位
    AxisXPos : LREAL; //手动X轴位置给定
    AxisYPos : LREAL; //手动Y轴位置给定
END_VAR
]]></Declaration>
