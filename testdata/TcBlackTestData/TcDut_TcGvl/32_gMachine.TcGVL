    bCalcSingleRowOK : BOOL;
    stProcessingDatasetsInuse : ST_ProcessingDatasets;
    // 速度信息
    lrProcessingVeloXInuse : LREAL := 10;
    lrProcessingVeloYInuse : LREAL := 20;
    lrProcessingVeloZInuse : LREAL := 10;
    // 视场信息
    lrViewWidthInUse : LREAL := 0.1920;
    lrViewHeightInUse : LREAL := 0.1536;
    bViewDatasetOKInUse : BOOL;
    // 目标区域
