    <Action Name="Act_InitAxesPara" Id="{e62f35d6-50be-49cb-a624-18050d4ecb0c}">
      <Implementation>
        <ST><![CDATA[END_PROGRAM

    // 接近开关信号输入与配置


 LimitSwitchSignalX.Level := NOT gIO.bNlimitX;

LimitSwitchSignalY.Level := NOT gIO.bNlimitY;

LimitSwitchSignalZ.Level := NOT gIO.bNlimitZ;


ReferencePulseSinalX.TouchProbe := E_TouchProbe.TouchProbe1;

ReferencePulseSinalX.SignalSource := E_SignalSource.SignalSource_ZeroPulse;


ReferencePulseSinalY.TouchProbe := E_TouchProbe.TouchProbe1;

ReferencePulseSinalY.SignalSource := E_SignalSource.SignalSource_ZeroPulse;


ReferencePulseSinalZ.TouchProbe := E_TouchProbe.TouchProbe1;

ReferencePulseSinalZ.SignalSource := E_SignalSource.SignalSource_ZeroPulse;


    // 第三方驱动器需置真


 mcStepReferenceX.Options.DisableDriveAccess := TRUE;

mcStepReferenceY.Options.DisableDriveAccess := TRUE;

mcStepReferenceZ.Options.DisableDriveAccess := TRUE;

mcFinishHomingX.Options.DisableDriveAccess := TRUE;

mcFinishHomingY.Options.DisableDriveAccess := TRUE;

mcFinishHomingZ.Options.DisableDriveAccess := TRUE;

mcStepLimitSwitchX.Options.DisableDriveAccess := TRUE;

mcStepLimitSwitchY.Options.DisableDriveAccess := TRUE;

mcStepLimitSwitchZ.Options.DisableDriveAccess := TRUE;
]]></ST>
      </Implementation>
    </Action>
